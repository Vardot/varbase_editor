# Ignore node modules
node_modules
/*/node_modules

# Ignore Yarn files
.yarn/

# Ignore the local GitLab CI runner working directory (gitlab-ci-local).
.gitlab-ci-local/

# Ignore varbase-e2e test artifacts (keep the .gitkeep placeholders only).
/tests/reports/*
!/tests/reports/.gitkeep
/tests/screenshots/*
!/tests/screenshots/.gitkeep
/tests/videos/*
!/tests/videos/.gitkeep

# JavaScript lockfiles are not committed: installs resolve from package.json
# (packageManager yarn@4.18.1, engines).
yarn.lock
package-lock.json
pnpm-lock.yaml
